PORTA: EQU 80H
PORTB: EQU 81H
PORTC: EQU 82H
CTRLP: EQU 83H
ORG 0000H
LXI SP,3FFFH
MVI A,10011001B
OUT CTRLP
MVI A,00H

CHECKKYP: 
	IN PORTC ;Make sure keypad are in portc 
	ANI 10H
	JZ CHECKKYP
	IN PORTC
	ANI 0FH
	CALL LOOK
	OUT PORTB
	JMP CHECKKYP
	HLT


LOOK: 
	LXI H,TABLE
	MOV L,A
	MOV A,M ;Make sure 7-segment display are in portb
	RET

	org 2000H
TABLE: DFB 06H,5BH,4FH,77H,66H,6DH,7DH,7CH,07H,7FH,6FH,39H,62H,3FH,76H,5EH
	
	
	
